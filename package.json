{
  "name": "blaksoc",
  "version": "0.1.0",
  "private": true,
  "description": "blakSOC — sovereign-capable multi-tenant SOC control plane by Yuma IT",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3107",
    "build": "next build",
    "start": "next start -p 3107",
    "worker": "tsx --env-file-if-exists=.env.local src/worker/index.ts",
    "worker:dev": "tsx watch --env-file-if-exists=.env.local src/worker/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local src/db/seed.ts",
    "db:attack": "tsx --env-file-if-exists=.env.local src/db/import-attack.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "build:worker": "esbuild src/worker/index.ts src/db/migrate.ts src/db/seed.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outdir=dist --out-extension:.js=.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1141.0",
    "@better-auth/sso": "^1.7.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "better-auth": "^1.7.6",
    "bullmq": "^6.3.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "undici": "^8.11.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
