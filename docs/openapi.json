          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Comma-separated, any of: OPEN, INVESTIGATING, CONTAINED, ERADICATED, RECOVERED, CLOSED",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "open",
            "in": "query",
            "required": false,
            "description": "true: everything not CLOSED",
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "default": 200,
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
