  "components": {
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "description": "Scopes are blakSOC permissions. A token carries every scope its identity holds; an identity never holds more than its creator.",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "/api/v1/oauth/token",
            "scopes": {
              "dashboard:read": "dashboard:read",
              "mssp:read": "mssp:read",
              "alert:read": "alert:read",
              "alert:triage": "alert:triage",
              "alert:assign": "alert:assign",
              "incident:read": "incident:read",
              "incident:write": "incident:write",
              "incident:close": "incident:close",
              "asset:read": "asset:read",
              "asset:write": "asset:write",
              "vuln:read": "vuln:read",
              "vuln:write": "vuln:write",
              "intel:read": "intel:read",
              "intel:write": "intel:write",
              "intel:share": "intel:share",
              "detection:read": "detection:read",
              "detection:write": "detection:write",
              "detection:deploy": "detection:deploy",
              "playbook:read": "playbook:read",
              "playbook:write": "playbook:write",
              "playbook:run": "playbook:run",
              "response:request": "response:request",
              "response:approve": "response:approve",
              "integration:read": "integration:read",
              "integration:manage": "integration:manage",
              "report:read": "report:read",
              "report:generate": "report:generate",
              "ai:use": "ai:use",
              "audit:read": "audit:read",
              "tenant:manage": "tenant:manage",
              "user:manage": "user:manage",
              "settings:manage": "settings:manage",
              "portal:read": "portal:read"
            }
          }
        }
      }
    },
    "schemas": {
      "Alert": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "tenantName": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "informational",
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "riskScore": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "status": {
            "type": "string",
            "enum": [
              "NEW",
              "TRIAGING",
              "INVESTIGATING",
              "ESCALATED",
              "CONTAINED",
              "RESOLVED",
              "FALSE_POSITIVE"
            ]
          },
          "source": {
            "type": "string"
          },
          "category": {
            "type": [
              "string",
              "null"
            ]
          },
          "assetId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "userName": {
            "type": [
              "string",
              "null"
            ]
          },
          "intelVerdict": {
            "type": "string"
          },
          "attackTechniques": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "ingestedAt": {
            "type": "string",
            "format": "date-time"
          },
          "incidentId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "observables": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                },
                "verdict": {
                  "type": "string"
                },
                "field": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "type",
                "value",
                "verdict",
                "field"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "tenantId",
          "tenantName",
          "title",
          "description",
          "severity",
          "riskScore",
          "status",
          "source",
          "category",
          "assetId",
          "userName",
          "intelVerdict",
          "attackTechniques",
          "occurredAt",
          "ingestedAt",
          "incidentId",
          "observables"
        ],
        "additionalProperties": false
      },
      "AlertList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AlertSummary"
