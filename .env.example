APP_URL=http://localhost:3107
# App role (RLS enforced), system role (worker and pre-scope paths) and owner (migrations/seed only)
# Passwords inside URLs must be percent-encoded; the migration checks them against the *_DB_PASSWORD values.
DATABASE_URL=postgres://blaksoc_app:change-me@localhost:55471/blaksoc
DATABASE_SYSTEM_URL=postgres://blaksoc_system:change-me-too@localhost:55471/blaksoc
DATABASE_ADMIN_URL=postgres://blaksoc:blaksoc@localhost:55471/blaksoc
BLAKSOC_APP_DB_PASSWORD=change-me
BLAKSOC_SYSTEM_DB_PASSWORD=change-me-too
REDIS_URL=redis://localhost:56471
# openssl rand -base64 48
BETTER_AUTH_SECRET=
# Cognito managed login: provision deploy/aws/cognito.yaml first. Domain is a hostname only.
COGNITO_REGION=ap-southeast-2
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=
COGNITO_ALLOWED_EMAIL_DOMAINS=yumait.com.au
# openssl rand -base64 32  (encrypts integration secrets)
BLAKSOC_ENCRYPTION_KEY=
# WebAuthn relying party id for passkeys. Defaults to the APP_URL hostname.
PASSKEY_RP_ID=
# Australian Business Register web services GUID (https://abr.business.gov.au/Tools/WebServices).
# Unset: setup checks the ATO example ABN only.
ABR_GUID=
# Multi-tenant Entra app for customer Microsoft 365 admin consent (Graph application permissions).
# Redirect URI: ${APP_URL}/onboarding/m365/callback. Unset: setup records sample Microsoft 365 data.
M365_CONNECTOR_CLIENT_ID=
M365_CONNECTOR_CLIENT_SECRET=
BREAK_GLASS_REQUIRE_MFA=true
AI_DATA_RESIDENCY=AU
# Seeds demo tenants/alerts and enables the mock event provider
DEMO_MODE=false
# 11-digit supplier ABN printed on quote and invoice exports. Leave empty until an operator sets it.
# Quote export returns 503 while this is unset. Do not put a sample ABN here.
BLAKSOC_SUPPLIER_ABN=
SSO_TRUSTED_ORIGINS=
# CIDRs of proxies in front of blakSOC; client IPs are read from X-Forwarded-For past them.
TRUSTED_PROXY_CIDRS=
# Observability (docs/observability.md). Logs are JSON lines; LOG_FORMAT=pretty for local reading.
LOG_LEVEL=info
# Serves /metrics on this port (web and worker each need their own, so set it per process locally).
# METRICS_PORT=9464
# OTLP/HTTP collector for traces. Unset: no spans are exported.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Cloudflare Radar on the SOC dashboard. API token with Account > Radar > Read.
# Unset: the dashboard cards explain how to create one. Do not commit the token.
# CLOUDFLARE_RADAR_TOKEN=
# Syslog archive. Unset: local files under BLAKSOC_ARCHIVE_DIR (not durable, dev only).
# Durable: AU buckets as region=bucket pairs (ap-southeast-2, ap-southeast-4). See docs/disaster-recovery.md.
BLAKSOC_ARCHIVE_S3_BUCKETS=
BLAKSOC_ARCHIVE_S3_ENDPOINT=
BLAKSOC_ARCHIVE_S3_SSE=AES256
BLAKSOC_ARCHIVE_S3_ACCESS_KEY_ID=
BLAKSOC_ARCHIVE_S3_SECRET_ACCESS_KEY=
